* text=auto

# Unity YAML files: merge as plain text, keep LF
*.unity    text eol=lf merge=unityyamlmerge
*.prefab   text eol=lf merge=unityyamlmerge
*.asset    text eol=lf merge=unityyamlmerge
*.meta     text eol=lf
*.mat      text eol=lf
*.anim     text eol=lf
*.controller text eol=lf
*.cs       text eol=lf diff=csharp

# Binary assets
*.png  binary
*.jpg  binary
*.psd  binary
*.aseprite binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
